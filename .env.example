# Assessment 3 — AI Integration Slice Environment Configuration

# Server Port (default: 3002)
PORT=3002

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Session Cookie Secret (minimum 32-character random string)
SESSION_SECRET=ai-slice-session-secret-key-at-least-32-chars-long!

# SQLite Database Path
DB_PATH=./ai_jobs.db

# Storage Directory for uploaded files (only storage keys stored in DB)
UPLOAD_DIR=./storage/uploads

# AI Model Configuration
# Place your provider API key below (OpenAI, Gemini, or compatible provider)
AI_API_KEY=your_provider_api_key_here
AI_MODEL_NAME=gpt-4o-mini

# Model Parameters
# Role 1: Requirements Extraction (deterministic, low temperature)
AI_ROLE1_TEMPERATURE=0.2
AI_ROLE1_MAX_TOKENS=1024

# Role 2: Interview Rubric Generation (creative synthesis, moderate temperature)
AI_ROLE2_TEMPERATURE=0.5
AI_ROLE2_MAX_TOKENS=1024

# Timeouts & Limits
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_JOBS=2

# Upload Constraints (in bytes: 51200 bytes = 50 KB)
MAX_FILE_SIZE_BYTES=51200
